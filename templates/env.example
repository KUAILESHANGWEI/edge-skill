# Dashboard: Worker -> Settings -> Variables and Secrets
# Secrets (use the secret/encrypt type, never plain text, never commit real values):
ADMIN=<STRONG_ADMIN_PASSWORD>
UUID=<UUID>
KEY=<QUICK_SUB_KEY>
# Plain variable (not a secret):
HOST=<YOUR_DOMAIN>
# First build: LEAVE THESE UNSET (see SKILL.md Section 3.2). Do not paste placeholder values for them.
# PROXYIP=        (unset = automatic per-colo reverse proxy with fallback)
# BEST_SUB=       (unset = private node, not a public preferred-sub generator)
# GO2SOCKS5=      (unset = built-in SOCKS5 whitelist only)
# PATH=           (unset = default /)
